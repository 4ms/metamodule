{
  "version": 2,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 19,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "description": "Common settings for all projects",
      "generator": "Ninja",
      "binaryDir": "build",
      "hidden": false,
      "cacheVariables": {
        "TOOLCHAIN_BASE_DIR":{
          "type": "FILEPATH",
          "value": ""
        },
        "CMAKE_TOOLCHAIN_FILE": {
          "type": "STRING",
          "value": "cmake/arm-none-eabi-gcc.cmake"
        }
      }
    },
    {
      "name": "full",
      "inherits": "base"
    },
    {
      "name": "debug-log",
      "inherits": "full",
      "cacheVariables": {
        "LOG_LEVEL":                     { "type": "STRING", "value": "INFO" },
        "SUPPRESS_HIL_MESSAGES":         { "type": "BOOL", "value": "OFF" }
  	  }
    },
    {
      "name": "min-brands",
      "inherits": "full",
      "cacheVariables": {
        "OMIT_BRAND_AudibleInstruments": { "type": "BOOL", "value": "ON" },
        "OMIT_BRAND_Befaco":             { "type": "BOOL", "value": "ON" }, 
        "OMIT_BRAND_hetrickcv":          { "type": "BOOL", "value": "ON" },
        "OMIT_BRAND_nonlinearcircuits":  { "type": "BOOL", "value": "ON" },
        "OMIT_BRAND_eightfold":          { "type": "BOOL", "value": "ON" },
        "OMIT_BRAND_Valley":             { "type": "BOOL", "value": "ON" },
        "OMIT_BRAND_RackCore":           { "type": "BOOL", "value": "ON" },
        "LOG_LEVEL":                     { "type": "STRING", "value": "DEBUG" },
        "SUPPRESS_HIL_MESSAGES":         { "type": "BOOL", "value": "ON" }
      }
    },
    {
      "name": "dyn-plugins",
      "inherits": "full",
      "cacheVariables": {
        "BUILD_DYN_PLUGIN_AudibleInstruments": { "type": "BOOL", "value": "ON" },
        "BUILD_DYN_PLUGIN_Befaco":             { "type": "BOOL", "value": "ON" }, 
        "BUILD_DYN_PLUGIN_hetrickcv":          { "type": "BOOL", "value": "ON" },
        "BUILD_DYN_PLUGIN_nonlinearcircuits":  { "type": "BOOL", "value": "ON" },
        "BUILD_DYN_PLUGIN_eightfold":          { "type": "BOOL", "value": "ON" }
      }
    },
    {
      "name": "befaco",
      "inherits": "full",
      "cacheVariables": {
        "BUILD_DYN_PLUGIN_AudibleInstruments": { "type": "BOOL", "value": "ON" },
        "BUILD_DYN_PLUGIN_hetrickcv":          { "type": "BOOL", "value": "ON" },
        "BUILD_DYN_PLUGIN_nonlinearcircuits":  { "type": "BOOL", "value": "ON" },
        "BUILD_DYN_PLUGIN_eightfold":          { "type": "BOOL", "value": "ON" }
      }
    },
    {
      "name": "mp2",
      "description": "MetaModule MP2 (pro): A35 + M33",
      "generator": "Ninja",
      "binaryDir": "build-mp2",
      "cacheVariables": {
        "METAMODULE_PLATFORM":  { "type": "STRING", "value": "mp2" },
        "TOOLCHAIN_BASE_DIR":   { "type": "FILEPATH", "value": "" },
        "CMAKE_TOOLCHAIN_FILE": { "type": "STRING", "value": "cmake/aarch64-none-elf-gcc.cmake" },
        "MP2_TEST_CARRIER":     { "type": "BOOL", "value": "OFF" }
      }
    },
    {
      "name": "mp2-test-carrier",
      "description": "MetaModule MP2 on the mp2-devboard test carrier (until p1 boards arrive)",
      "inherits": "mp2",
      "binaryDir": "build-mp2-test-carrier",
      "cacheVariables": {
        "MP2_TEST_CARRIER":     { "type": "BOOL", "value": "ON" }
      }
    },
    {
      "name": "mp2-linux-gnu",
      "description": "MetaModule MP2 compile-check with aarch64-linux-gnu (objects only, link needs newlib): build target a35_core",
      "inherits": "mp2",
      "binaryDir": "build-mp2-linux-gnu",
      "cacheVariables": {
        "TOOLCHAIN_TRIPLE":     { "type": "STRING", "value": "aarch64-linux-gnu" }
      }
    },
    {
      "name": "audible",
      "inherits": "full",
      "cacheVariables": {
        "BUILD_DYN_PLUGIN_Befaco":             { "type": "BOOL", "value": "ON" }, 
        "BUILD_DYN_PLUGIN_hetrickcv":          { "type": "BOOL", "value": "ON" },
        "BUILD_DYN_PLUGIN_nonlinearcircuits":  { "type": "BOOL", "value": "ON" },
        "BUILD_DYN_PLUGIN_eightfold":          { "type": "BOOL", "value": "ON" }
      }
    }
  ],
  "buildPresets": [
    {
      "name": "base",
      "configurePreset": "base"
    },
    {
      "name": "full",
      "configurePreset": "full"
    },
    {
      "name": "dyn-plugins",
      "configurePreset": "dyn-plugins"
    },
    {
      "name": "debug-log",
      "configurePreset": "debug-log"
    },
    {
      "name": "min-brands",
      "configurePreset": "min-brands"
    },
    {
      "name": "mp2",
      "configurePreset": "mp2"
    },
    {
      "name": "mp2-test-carrier",
      "configurePreset": "mp2-test-carrier"
    }
  ]
}
